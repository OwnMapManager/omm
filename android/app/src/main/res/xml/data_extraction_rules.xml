<?xml version="1.0" encoding="utf-8"?>
<!-- OMM nie korzysta z kopii zapasowej Androida (ani w chmurze Google, ani przy przenoszeniu na nowy telefon).
     Dane są tylko w telefonie i w kopiach, które użytkownik sam zapisuje (lokalnie / na Dysk Google). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
